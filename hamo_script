    ---------------------------------------------------------
    local function ser(v, d)
        d = d or 0
        local t = typeof(v)
        if t == "string" then return string.format("%q", #v > 60 and v:sub(1, 60) or v)
        elseif t == "table" then
            if d > 2 then return "{..}" end
            local o, n = {}, 0
            for k, x in pairs(v) do
                n += 1
                if n > 8 then o[#o + 1] = ".." break end
                o[#o + 1] = tostring(k) .. "=" .. ser(x, d + 1)
            end
            return "{" .. table.concat(o, ",") .. "}"
        elseif t == "Instance" then return "Inst(" .. v:GetFullName() .. ")"
        elseif t == "Vector3" then return string.format("V3(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z)
        elseif t == "CFrame" then local p = v.Position return string.format("CF(%.1f,%.1f,%.1f)", p.X, p.Y, p.Z)
        end
        return tostring(v)
    end

    local function attrsOf(i)
        local t = {}
        for k, v in pairs(i:GetAttributes()) do
            if not tostring(k):find("^__") then t[#t + 1] = k .. "=" .. ser(v) end
        end
        return #t > 0 and (" {" .. table.concat(t, ", ") .. "}") or ""
    end

    local function treeTo(o, inst, depth, maxD, limit)
        if depth > maxD then return end
        local kids = inst:GetChildren()
        for i, c in ipairs(kids) do
            if i > limit then o[#o + 1] = string.rep("  ", depth) .. "... +" .. (#kids - limit) break end
            o[#o + 1] = string.rep("  ", depth) .. c.Name .. " [" .. c.ClassName .. "]" .. attrsOf(c)
            treeTo(o, c, depth + 1, maxD, limit)
        end
    end

    local function parseSet(s)
        local t = {}
        for n in tostring(s or ""):gmatch("%d+") do t[tonumber(n)] = true end
        return t
    end
    local function maxKey(t)
