do
    local P = SafePage
    Section(P, "🛡️ Anti-Hit (قذف / شلل / دفع / تصادم)")

    local Blocked = {fling = 0, state = 0, vel = 0}
    local Flipped = setmetatable({}, {__mode = "k"})
    local ARemotes, NPCs, CharConns = {}, {}, {}
    local LastSpeed = 16
    local PATTERNS = {"fling", "ragdoll", "knock", "stun", "stagger", "launch"}
    local KB = {"BodyVelocity", "BodyForce", "BodyPosition", "BodyThrust", "BodyAngularVelocity",
        "LinearVelocity", "VectorForce", "AngularVelocity", "AlignPosition"}
    local AntiStat

    local function matches(name)
        name = name:lower()
        for _, w in ipairs(PATTERNS) do
            if name:find(w, 1, true) then return true end
        end
        return false
    end

    local function countFn() Blocked.fling += 1 end

    local function addRemote(r)
        if r:IsA("RemoteEvent") and matches(r.Name) and not ARemotes[r] then
            ARemotes[r] = true
            Track(r.OnClientEvent:Connect(countFn))
        end
    end
    for _, d in ipairs(RS:GetDescendants()) do addRemote(d) end
    Track(RS.DescendantAdded:Connect(addRemote))

    local function applyBlock(on)
        if not getconnections then return end
        for r in pairs(ARemotes) do
            local ok, list = pcall(getconnections, r.OnClientEvent)
            if ok and list then
                for _, c in ipairs(list) do
                    local ours = false
                    pcall(function() ours = (c.Function == countFn) end)
                    if not ours then
                        pcall(function()
                            if on then c:Disable() else c:Enable() end
                        end)
                    end
                end
            end
        end
    end

    local function lockStates(h)
        local off = State.antihit and true or false
        for _, s in ipairs({Enum.HumanoidStateType.Ragdoll, Enum.HumanoidStateType.FallingDown, Enum.HumanoidStateType.Physics}) do
            pcall(function() h:SetStateEnabled(s, not off) end)
        end
    end

    local function guardChar(char)
        for _, c in ipairs(CharConns) do pcall(function() c:Disconnect() end) end
        CharConns = {}
        local function guard(d)
            if d:IsA("BallSocketConstraint") then
                if State.antihit then d.Enabled = false end
            elseif d:IsA("Motor6D") and d.Parent and d.Parent:IsA("BasePart") then
                CharConns[#CharConns + 1] = d:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if State.antihit and not d.Enabled then
                        d.Enabled = true
                        Blocked.state += 1
                    end
                end)
            end
        end
        for _, d in ipairs(char:GetDescendants()) do guard(d) end
        CharConns[#CharConns + 1] = char.DescendantAdded:Connect(guard)
        local h = char:WaitForChild("Humanoid", 5)
        if h then lockStates(h) end
    end

    if Player.Character then task.spawn(guardChar, Player.Character) end
    Track(Player.CharacterAdded:Connect(function(c)
        task.wait(0.5)
        guardChar(c)
    end))

    Track(RunService.Heartbeat:Connect(function()
        if not State.antihit then return end
        local r, h = GetRoot(), GetHum()
        if not (r and h) then return end

        if h.PlatformStand then
            h.PlatformStand = false
            Blocked.state += 1
        end
        local st = h:GetState()
        if st == Enum.HumanoidStateType.Ragdoll or st == Enum.HumanoidStateType.FallingDown
            or st == Enum.HumanoidStateType.Physics then
            h:ChangeState(Enum.HumanoidStateType.GettingUp)
            Blocked.state += 1
        end

        if h.WalkSpeed >= 1 then
            LastSpeed = h.WalkSpeed
        elseif State.antiunfreeze then
            h.WalkSpeed = LastSpeed
            Blocked.state += 1
        end

        if not r:FindFirstChildOfClass("BodyGyro") then
            for _, c in ipairs(r:GetChildren()) do
                for _, cn in ipairs(KB) do
                    if c:IsA(cn) then
                        c:Destroy()
                        Blocked.vel += 1
                        break
                    end
                end
            end

            local v = r.AssemblyLinearVelocity
            local capv = math.max(h.WalkSpeed * 1.3, 24) + 10
            if Vector3.new(v.X, 0, v.Z).Magnitude > capv then
                local md = h.MoveDirection
                local nv = md.Magnitude > 0 and md.Unit * h.WalkSpeed or Vector3.zero
                r.AssemblyLinearVelocity = Vector3.new(nv.X, v.Y, nv.Z)
                Blocked.vel += 1
                v = r.AssemblyLinearVelocity
            end
            if v.Y > 75 then
                r.AssemblyLinearVelocity = Vector3.new(v.X, 50, v.Z)
                Blocked.vel += 1
            end
        end
        if r.AssemblyAngularVelocity.Magnitude > 8 then
            r.AssemblyAngularVelocity = Vector3.zero
        end
    end))

    local function nocollide(model)
        for _, part in ipairs(model:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
                Flipped[part] = true
            end
        end
    end

    local function restoreCollide()
        for part in pairs(Flipped) do
            if part.Parent then part.CanCollide = true end
            Flipped[part] = nil
        end
    end

    local function refreshNPCs()
        local list = {}
        local b = workspace:FindFirstChild("Build")
        local zb = b and b:FindFirstChild("ZoneBuilds")
        if zb then
            for _, h in ipairs(zb:GetDescendants()) do
                if h:IsA("Humanoid") and h.Parent then list[#list + 1] = h.Parent end
            end
        end
        NPCs = list
    end

    local lastNC = 0
    Track(RunService.Stepped:Connect(function()
        if not State.antihit then return end
        local now = os.clock()
        if now - lastNC < 0.2 then return end
        lastNC = now
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl ~= Player and pl.Character then nocollide(pl.Character) end
        end
        for _, m in ipairs(NPCs) do
            if m.Parent then nocollide(m) end
        end
    end))

    local function setAnti(v)
        local h = GetHum()
        if h then lockStates(h) end
        applyBlock(v)
        if v then refreshNPCs() else restoreCollide() end
    end

