---------------------------------------------------------
-- 🎌 Anime Pack
---------------------------------------------------------
do
    local P = AnimePage
    local Cooldown = {}
    local RARITIES = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Cosmic", "Divine", "Omniversal"}
    local RANK = {}
    for i, n in ipairs(RARITIES) do RANK[lower(n)] = i end
    local Chosen = {}
    for _, n in ipairs(RARITIES) do Chosen[lower(n)] = true end
    local StatusLbl, PlaceLbl
    local Warned = {}

    local function SetPlace(t) if PlaceLbl then PlaceLbl.Text = t end end

    local function Brief(v)
        if typeof(v) == "table" then
            local out, n = {}, 0
            for k, x in pairs(v) do
                n += 1
                if n > 4 then break end
                table.insert(out, tostring(k) .. "=" .. tostring(x))
            end
            return "{" .. table.concat(out, ",") .. "}"
        end
        return tostring(v)
    end

    local function ParseWeight(p)
        local d = p:GetAttribute("DetailText") or ""
        return tonumber(string.match(d, "%[([%d%.]+)%s*[kK][gG]%]")) or 0
    end

    local function RarityOf(p)
        return lower((tostring(p:GetAttribute("DetailRarity") or ""):gsub("%s+", "")))
    end

    local function StageOf(p)
        local cur = p
        while cur and cur.Name ~= "SpawnedPacks" do cur = cur.Parent end
        return cur and cur.Parent and cur.Parent.Name or "?"
    end

    local function PackNameOf(p)
        local m = p.Parent and p.Parent.Parent and p.Parent.Parent.Parent
        return m and m.Name or "?"
    end

    local function FindChosen()
        local list = {}
        local game_ = workspace:FindFirstChild("Game")
        local packs = game_ and game_:FindFirstChild("Packs")
        if not packs then return list end
        local r = GetRoot()
        for _, p in ipairs(packs:GetDescendants()) do
            if p:IsA("ProximityPrompt") and p.Name == "StealPrompt" and p.Enabled
                and (Cooldown[p] or 0) < os.clock() then
                local rar = RarityOf(p)
                local rank = RANK[rar]
                if not rank and rar ~= "" and not Warned[rar] then
                    Warned[rar] = true
                    warn("[HAMO] ندرة غير معروفة: " .. rar)
                end
                if rank and Chosen[rar] then
                    local pos = PromptPos(p)
                    if pos then
                        table.insert(list, {p = p, pos = pos, rank = rank, w = ParseWeight(p), d = r and (pos - r.Position).Magnitude or 0})
                    end
                end
            end
        end
        table.sort(list, function(a, b)
            if a.rank ~= b.rank then return a.rank > b.rank end
            if a.w ~= b.w then return a.w > b.w end
            return a.d < b.d
        end)
        return list
    end

    local function TrySteal(item)
        local r = GetRoot()
        if not r then return false end
        r.CFrame = CFrame.new(item.pos + Vector3.new(0, 3, 0))
        task.wait(0.25)
        local before = LastGrab
        UsePrompt(item.p)
        local t = os.clock()
        while os.clock() - t < 1.2 and LastGrab == before do task.wait(0.05) end
        if LastGrab == before then
            pcall(function()
                item.p:InputHoldBegin()
                task.wait(item.p.HoldDuration + 0.2)
                item.p:InputHoldEnd()
            end)
            t = os.clock()
            while os.clock() - t < 1 and LastGrab == before do task.wait(0.05) end
        end
        local ok = LastGrab ~= before
        Cooldown[item.p] = os.clock() + (ok and 3 or 8)
        return ok
    end

    local Seen = setmetatable({}, {__mode = "k"})
    local Pending = setmetatable({}, {__mode = "k"})

    local function ToolSet()
        local s = {}
        local bp = Player:FindFirstChildOfClass("Backpack")
        if bp then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("PackId") then s[t] = true end
            end
        end
        local ch = Player.Character
        if ch then
            for _, t in ipairs(ch:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("PackId") then s[t] = true end
            end
        end
        return s
    end

    for t in pairs(ToolSet()) do Seen[t] = true end
    task.spawn(function()
        while Alive do
            for t in pairs(ToolSet()) do
                if not Seen[t] then
                    Seen[t] = true
                    Pending[t] = os.clock()
                end
            end
            task.wait(0.25)
        end
    end)

    local PLACE_OFFSETS = {}
    for _, rad in ipairs({4, 6, 8, 10, 12}) do
        for i = 0, 7 do
            local a = i * math.pi / 4 + rad * 0.3
            table.insert(PLACE_OFFSETS, Vector3.new(math.cos(a) * rad, 0, math.sin(a) * rad))
        end
    end
    local PlaceCursor = 0

    local function PlacedCount()
        local _, pm = MyPlot()
        local pp = pm and pm:FindFirstChild("PlacedPacks")
        return pp and #pp:GetChildren() or 0
    end

    local function Consumed(tool)
        if not tool.Parent then return true end
        if tool:IsDescendantOf(Player) then return false end
        if Player.Character and tool:IsDescendantOf(Player.Character) then return false end
        return true
    end

    local function PlaceTool(tool)
        local id = tool:GetAttribute("PackId")
        if not id then return false, "no PackId" end

        Call("Tools.RequestEquip", {Tool = tool, Equipped = true})
        local t0 = os.clock()
        while os.clock() - t0 < 1 and Player.Character and tool.Parent ~= Player.Character do
            task.wait(0.05)
        end
        if tool.Parent ~= Player.Character then
            local h = GetHum()
            if h then pcall(function() h:EquipTool(tool) end) end
            task.wait(0.2)
        end

        local root = GetRoot()
        if not root then return false, "no root" end
        local base = root.Position
        local y = base.Y - 3.3
        local before = PlacedCount()
        local lastRes = "-"

        for _ = 1, 24 do
            if not Alive then return false, lastRes end
            PlaceCursor = PlaceCursor % #PLACE_OFFSETS + 1
            local o = PLACE_OFFSETS[PlaceCursor]
            local _, res = Call("Packs.PlaceOwned", {
                Position = Vector3.new(base.X + o.X, y, base.Z + o.Z),
                PackId = id,
            })
            lastRes = Brief(res)
            task.wait(0.3)
            if Consumed(tool) or PlacedCount() > before then
                return true, lastRes
            end
        end
        return false, lastRes
    end

    local function PostSteal(g)
        SetPlace("⏳ انتظار " .. StealDelay .. " ثانية...")
        task.wait(StealDelay)
        GoBase()
        task.wait(0.5)

        -- تفريغ Pending دائماً (إصلاح التسريب)
        local list = {}
        for t, tm in pairs(Pending) do
            if tm >= g - 2.5 and t.Parent then table.insert(list, t) end
            Pending[t] = nil
        end

        if not State.autoplace then return end
        if #list == 0 then
            SetPlace("لم أجد حقيبة جديدة لوضعها")
            return
        end
        for _, t in ipairs(list) do
            if not Alive then break end
            local name = t.Name
            local ok, info = PlaceTool(t)
            SetPlace((ok and "✅ وُضعت: " or "❌ فشل وضع: ") .. name .. " | رد: " .. info)
        end
    end

    do
        local grab = GetRemote("FX.PackGrab")
        if grab and grab:IsA("RemoteEvent") then
            Track(grab.OnClientEvent:Connect(function(data)
                if type(data) == "table" and typeof(data.Root) == "Instance"
                    and Player.Character and data.Root:IsDescendantOf(Player.Character) then
                    LastGrab = os.clock()
                    if State.steal and not Busy then
                        local g = LastGrab
                        task.spawn(function()
                            WithBusy(function() PostSteal(g) end)
                        end)
                    end
                end
            end))
        end
    end

    local function ReadyHatcheries()
        local out = {}
        local _, pm = MyPlot()
        local placed = pm and pm:FindFirstChild("PlacedPacks")
        if not placed then return out end
        local now = workspace:GetServerTimeNow()
        for _, m in ipairs(placed:GetChildren()) do
            local id = m:GetAttribute("PackId")
            local ends = m:GetAttribute("HatcheryEndsAt")
            if id and m:GetAttribute("IsHatchery") and ends and now >= ends then
                table.insert(out, id)
            end
        end
        return out
    end

    Section(P, "السرقة")

    AddToggle(P, "🤝 بعد سرقتي اليدوية: انتظر ثم ارجع للقاعدة", "steal", function(v)
        if v then EnsureBase() end
    end)

    AddToggle(P, "🤖 سرقة تلقائية (الندرات المختارة فقط)", "autosteal", function(v)
        if not v then
            if StatusLbl then StatusLbl.Text = "الحالة: متوقفة" end
            return
        end
        EnsureBase()
        Loop("autosteal", 0.3, function()
            if Busy or not GetRoot() then return end
            local any = false
            for _, on in pairs(Chosen) do if on then any = true break end end
            if not any then
                if StatusLbl then StatusLbl.Text = "⚠️ اختر ندرة واحدة على الأقل" end
                return
            end
            local best = FindChosen()[1]
            if not best then
                if StatusLbl then StatusLbl.Text = "🔎 لا توجد حقيبة بالندرات المختارة الآن" end
                return
            end
            if StatusLbl then
                StatusLbl.Text = string.format("🎯 %s | %s | %s | %skg", StageOf(best.p), PackNameOf(best.p), RARITIES[best.rank], best.w)
            end
            WithBusy(function()
                if TrySteal(best) then
                    PostSteal(LastGrab)
                else
                    task.wait(0.3)
                    GoBase()
                end
            end)
            task.wait(0.5)
        end)
    end)

    AddStepper(P, "الانتظار بعد السرقة (ثانية)", 0.5, 5, 0.5, 1.5, function(v) StealDelay = v end)

    StatusLbl = Section(P, "الحالة: متوقفة")
    StatusLbl.TextColor3 = TH.on
    StatusLbl.TextSize = 10

    Section(P, "اختر الندرات التي تريد سرقتها")

    local chipColors = {
        common = Color3.fromRGB(150, 150, 160), uncommon = Color3.fromRGB(90, 200, 110),
        rare = Color3.fromRGB(70, 150, 255), epic = Color3.fromRGB(170, 90, 255),
        legendary = Color3.fromRGB(255, 170, 40), mythical = Color3.fromRGB(255, 80, 120),
        cosmic = Color3.fromRGB(60, 220, 230), divine = Color3.fromRGB(255, 235, 120),
        omniversal = Color3.fromRGB(255, 90, 90),
    }
    local grid = Instance.new("Frame")
    grid.Size = UDim2.new(1, -4, 0, 0)
    grid.AutomaticSize = Enum.AutomaticSize.Y
    grid.BackgroundTransparency = 1
    grid.LayoutOrder = nextOrder(P)
    grid.Parent = P
    do
        local g = Instance.new("UIGridLayout")
        g.CellSize = UDim2.new(0.32, 0, 0, 30)
        g.CellPadding = UDim2.new(0.02, 0, 0, 6)
        g.SortOrder = Enum.SortOrder.LayoutOrder
        g.Parent = grid
    end
    for i, name in ipairs(RARITIES) do
        local key = lower(name)
        local col = chipColors[key]
        local b = Instance.new("TextButton")
        b.LayoutOrder = i
        b.Text = name
        b.Font = Enum.Font.GothamBold
        b.TextSize = 10
        b.AutoButtonColor = false
        b.Parent = grid
        Corner(b, 9)
        Stroke(b, col, 1.4, 0.35)
        local function paint()
            if Chosen[key] then
                b.BackgroundColor3 = col
                b.TextColor3 = Color3.fromRGB(10, 10, 14)
            else
                b.BackgroundColor3 = TH.card
                b.TextColor3 = col
            end
        end
        paint()
        b.MouseButton1Click:Connect(function()
            Chosen[key] = not Chosen[key]
            paint()
        end)
    end

    local function SetAll(v)
        for _, n in ipairs(RARITIES) do Chosen[lower(n)] = v end
        for _, c in ipairs(grid:GetChildren()) do
            if c:IsA("TextButton") then
                local col = chipColors[lower(c.Text)]
                c.BackgroundColor3 = v and col or TH.card
                c.TextColor3 = v and Color3.fromRGB(10, 10, 14) or col
            end
        end
    end
    AddButton(P, "✅ تحديد الكل", nil, function() SetAll(true) end)
    AddButton(P, "⬜ إلغاء الكل", nil, function() SetAll(false) end)

    Section(P, "القاعدة")

    AddToggle(P, "📥 وضع الحقيبة المسروقة في القاعدة بعد كل سرقة", "autoplace")

    PlaceLbl = Section(P, "حالة الوضع: -")
    PlaceLbl.TextColor3 = TH.on
    PlaceLbl.TextSize = 10
    PlaceLbl.TextWrapped = true

    AddButton(P, "🧪 اختبار الوضع: ضع حقيبة واحدة معي الآن", nil, function()
        WithBusy(function()
            local pick
            for t in pairs(ToolSet()) do
                if t:GetAttribute("CardIsPack") then pick = t break end
                pick = pick or t
            end
            if not pick then
                SetPlace("❌ لا توجد حقيبة معك")
                return
            end
            GoBase()
            task.wait(0.5)
            local name = pick.Name
            local ok, info = PlaceTool(pick)
            SetPlace((ok and "✅ وُضعت: " or "❌ فشل وضع: ") .. name .. " | رد: " .. info)
        end)
    end)

    AddToggle(P, "📦 فتح الحقائب الجاهزة تلقائياً", "autoopen", function(v)
        if not v then return end
        Loop("autoopen", 3, function()
            for _, id in ipairs(ReadyHatcheries()) do
                if not State.autoopen then return end
                Call("Packs.OpenOwned", id)
                task.wait(0.5)
            end
        end)
    end)

    Section(P, "أخرى")

    AddToggle(P, "🎁 جمع المكافآت (يومي / هدية / أوفلاين)", "claim", function(v)
        if not v then return end
        Loop("claim", 20, function()
            Call("Daily.Claim")
            Call("FreeGift.Claim")
            Call("Offline.Claim")
            local plot = MyPlot()
            if plot then
                for _, d in ipairs(plot:GetDescendants()) do
                    if d:IsA("ProximityPrompt") and d.Name == "FreeGiftProxy" and d.Enabled then
                        UsePrompt(d)
                    end
                end
            end
        end)
    end)

    AddToggle(P, "🏃 ترقية المشاية تلقائياً", "treadmill", function(v)
        if not v then return end
        Loop("treadmill", 5, function()
            local plot = MyPlot()
