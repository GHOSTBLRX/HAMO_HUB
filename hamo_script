    f.Size = UDim2.new(1, -4, 0, 40)
    f.BackgroundColor3 = TH.card
    f.BackgroundTransparency = 0.08
    f.LayoutOrder = nextOrder(page)
    f.Parent = page
    Corner(f, 10)
    Stroke(f, Color3.fromRGB(70, 70, 100), 1, 0.65)

    local val = default
    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.Size = UDim2.new(1, -104, 1, 0)
