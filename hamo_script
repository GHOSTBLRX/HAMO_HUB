    lbl.TextColor3 = TH.text
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 11
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = f

    local function mk(sym, x, d)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 26, 0, 24)
        b.Position = UDim2.new(1, x, 0.5, -12)
        b.BackgroundColor3 = TH.cardHi
        b.Text = sym
        b.TextColor3 = TH.text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 14
        b.AutoButtonColor = false
        b.Parent = f
        Corner(b, 7)
        Stroke(b, TH.violet, 1, 0.7)
        b.MouseEnter:Connect(function() tw(b, 0.12, {BackgroundColor3 = TH.violet}) end)
        b.MouseLeave:Connect(function() tw(b, 0.12, {BackgroundColor3 = TH.cardHi}) end)
        b.MouseButton1Click:Connect(function()
            val = math.clamp(val + d * step, min, max)
            lbl.Text = text .. ": " .. val
            onChange(val)
        end)
    end
    mk("−", -68, -1)
    mk("+", -36, 1)
    onChange(val)
end

