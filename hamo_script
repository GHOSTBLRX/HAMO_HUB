                if key == "unknown" then unk += 1 end

                local zNum = zoneIdOf(m)
                local remaining = despawnAt(m) - now
                local urgent = remaining < 30
                local caught = isCaught(m)

                if Chosen[key]
                    and (zNum == nil or ChosenZ[zNum])
