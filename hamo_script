local Remotes = RS:FindFirstChild("Remotes")

local function GetRemote(path)
    local cur = Remotes
    for part in string.gmatch(path, "[^%.]+") do
        cur = cur and cur:FindFirstChild(part)
    end
    if cur then return cur end

    cur = RS
    for part in string.gmatch(path, "[^%.]+") do
        cur = cur and cur:FindFirstChild(part)
    end
    if cur then return cur end

    local last = path:match("([^%.]+)$")
    if last then
        for _, d in ipairs(RS:GetDescendants()) do
            if d.Name == last then return d end
        end
    end
end

local function FindRemote(name)
    local r = RS:FindFirstChild(name)
    if r then return r end
    if Remotes then
        r = Remotes:FindFirstChild(name)
        if r then return r end
        for _, c in ipairs(Remotes:GetDescendants()) do
            if c.Name == name then return c end
        end
    end
    for _, c in ipairs(RS:GetDescendants()) do
        if c.Name == name then return c end
    end
end

-- يرجع: ok, ردّ السيرفر
local function Call(path, ...)
    local r = GetRemote(path)
    if not r then return false, "remote not found" end
    local args = table.pack(...)
    return pcall(function()
        if r:IsA("RemoteFunction") then
            return r:InvokeServer(table.unpack(args, 1, args.n))
        else
            r:FireServer(table.unpack(args, 1, args.n))
        end
    end)
end

