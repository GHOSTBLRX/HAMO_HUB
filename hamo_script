local function Loop(key, interval, fn)
    Gen[key] = (Gen[key] or 0) + 1
    local my = Gen[key]
    task.spawn(function()
        while Alive and State[key] and Gen[key] == my do
            local ok, e = pcall(fn)
            if not ok then warn("[HAMO:" .. key .. "] " .. tostring(e)) end
            task.wait(interval)
            if Gen[key] ~= my then break end
        end
    end)
end

