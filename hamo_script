    Section(BS, "🥚 البيض والتشخيص")

    local Scout, counts = {}, {}
    local NOISY = {"SpeedGain", "Treadmill", "Notify", "AntiAfk", "conch", "Analytics"}
    local function rootPos()
        local r = GetRoot()
        return r and ser(r.Position) or "?"
    end

    _G.HamoBSCB = function(self, args)
        if not State.bs_scout or #Scout >= 250 then return end
        local full = self:GetFullName()
        if not full:find("ReplicatedStorage", 1, true) then return end
        for _, w in ipairs(NOISY) do if full:find(w, 1, true) then return end end
        counts[full] = (counts[full] or 0) + 1
        if counts[full] > 12 then return end
        local parts = {}
        for i = 1, args.n do parts[#parts + 1] = ser(args[i]) end
        Scout[#Scout + 1] = string.format("[OUT] %s(%s) | pos=%s", self.Name, table.concat(parts, ", "), rootPos())
    end
    if hookmetamethod and getnamecallmethod and not _G.HamoBSHooked then
        _G.HamoBSHooked = true
        -- pcall: بعض منفّذات الجوال تفشل في hook __namecall وتُسقِط السكربت كله
        local hooked = pcall(function()
            local wrap = newcclosure or function(f) return f end
            local old
            old = hookmetamethod(game, "__namecall", wrap(function(self, ...)
                local cb = _G.HamoBSCB
                if cb then
                    local m = getnamecallmethod()
                    if (m == "FireServer" or m == "InvokeServer") and typeof(self) == "Instance" then
                        task.defer(cb, self, table.pack(...))
                    end
                end
                return old(self, ...)
            end))
        end)
        if not hooked then
            _G.HamoBSHooked = false
            warn("[HAMO] hookmetamethod غير مدعوم — سيتم استخدام وضع المراقبة البديل")
        end
    end
    for _, r in ipairs(RS:GetDescendants()) do
        local n = lw(r.Name)
        if r:IsA("RemoteEvent") and (n:find("egg") or n:find("animal") or n:find("carry") or n:find("catch") or n:find("bank")) then
            Track(r.OnClientEvent:Connect(function(...)
                if not State.bs_scout or #Scout >= 250 then return end
                local args = table.pack(...)
                local parts = {}
                for i = 1, args.n do parts[#parts + 1] = ser(args[i]) end
                Scout[#Scout + 1] = string.format("[IN ] %s(%s) | pos=%s", r.Name, table.concat(parts, ", "), rootPos())
            end))
        end
    end
    table.insert(Cleanups, function() _G.HamoBSCB = nil end)

