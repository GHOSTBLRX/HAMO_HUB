                        remaining = remaining,
                        urgent = urgent,
                        d = r and (hrp.Position - r.Position).Magnitude or 0,
                    }
                end
            end
        end

        table.sort(list, function(a, b)
            if a.urgent ~= b.urgent then return a.urgent end
            if a.rank ~= b.rank then return a.rank > b.rank end
            if a.w ~= b.w then return a.w > b.w end
            return a.d < b.d
        end)
