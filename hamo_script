    b.Text = "  " .. text
    b.TextColor3 = TH.sub
    b.Font = Enum.Font.GothamBold
    b.TextSize = 11
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.AutoButtonColor = false
    b.Parent = Sidebar
    Corner(b, 9)

    local ind = Instance.new("Frame")
    ind.Size = UDim2.new(0, 3, 0, 0)
    ind.Position = UDim2.new(0, 0, 0.5, 0)
    ind.AnchorPoint = Vector2.new(0, 0.5)
    ind.BackgroundColor3 = Color3.new(1, 1, 1)
    ind.BorderSizePixel = 0
    ind.Visible = false
    ind.Parent = b
    Corner(ind, 2)
    Grad(ind, TH.violet, TH.cyan, 90)

    table.insert(Pages, page)
    table.insert(TabBtns, b)

    local function activate()
        for i, p in ipairs(Pages) do
            p.Visible = false
            TabBtns[i].BackgroundTransparency = 0.97
            TabBtns[i].TextColor3 = TH.sub
            local child = TabBtns[i]:FindFirstChildOfClass("Frame")
            if child then child.Visible = false end
        end
        page.Visible = true
        page.Position = UDim2.new(0, 14, 0, 0)
        tw(page, 0.22, {Position = UDim2.new(0, 0, 0, 0)})
        b.BackgroundTransparency = 0.88
        b.TextColor3 = TH.text
        ind.Visible = true
        tw(ind, 0.2, {Size = UDim2.new(0, 3, 0, 20)})
    end

    b.MouseButton1Click:Connect(activate)
    b.MouseEnter:Connect(function()
        if page.Visible then return end
        tw(b, 0.15, {BackgroundTransparency = 0.93})
    end)
    b.MouseLeave:Connect(function()
        if page.Visible then return end
        tw(b, 0.15, {BackgroundTransparency = 0.97})
    end)

    return page, activate
end

