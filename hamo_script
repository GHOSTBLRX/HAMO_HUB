                local hrp = m:FindFirstChild("HumanoidRootPart")
                if hrp then
                    total += 1
                    local z = zoneIdOf(m) or zoneOf(hrp.Position) or 0
                    perZone[z] = (perZone[z] or 0) + 1
                end
            end
        end
        for _, z in ipairs(Zones) do
            o[#o + 1] = string.format("Zone%d @%s | حيوانات: %d", z.n, ser(z.pos), perZone[z.n] or 0)
        end

        o[#o + 1] = "\n== AnimalPickups (أول 6 من " .. total .. ") =="
        if pk then
            for i, m in ipairs(pk:GetChildren()) do
                if i > 6 then break end
                local hrp = m:FindFirstChild("HumanoidRootPart")
                local pr = hrp and hrp:FindFirstChild("StealPrompt", true)
                o[#o + 1] = m.Name .. attrsOf(m) .. " | الندرة: " .. tostring(rarityOf(m))
                if hrp then o[#o + 1] = "  HRP" .. attrsOf(hrp) .. " @" .. ser(hrp.Position) end
                if pr then o[#o + 1] = "  Prompt" .. attrsOf(pr) .. " parent=" .. pr.Parent.ClassName end
            end
        end

        o[#o + 1] = "\n== Eggs =="
        for _, c in ipairs(workspace:GetChildren()) do
            if lw(c.Name):find("egg") then
                o[#o + 1] = c.Name .. " [" .. c.ClassName .. "]" .. attrsOf(c)
                treeTo(o, c, 1, 2, 8)
            end
        end
        local plot = myPlot()
        if plot then
            for _, c in ipairs(plot:GetChildren()) do
                if lw(c.Name):find("egg") then
                    o[#o + 1] = "plot." .. c.Name .. " [" .. c.ClassName .. "]" .. attrsOf(c)
                    treeTo(o, c, 1, 2, 8)
                end
            end
        end
        local zb = workspace:FindFirstChild("Build") and workspace.Build:FindFirstChild("ZoneBuilds")
        if zb then
            local z1 = zb:GetChildren()[1]
            if z1 then
                o[#o + 1] = "ZoneBuilds." .. z1.Name .. attrsOf(z1)
                treeTo(o, z1, 1, 2, 8)
            end
        end

        o[#o + 1] = "\n== واجهة Trails/Pickaxes =="
        local f = mainFrames()
        if f then
            local names = {}
            for _, c in ipairs(f:GetChildren()) do names[#names + 1] = c.Name end
            o[#o + 1] = "Frames: " .. table.concat(names, ", ")
            for _, c in ipairs(f:GetChildren()) do
                if lw(c.Name):find("trail") then
                    o[#o + 1] = c.Name
                    treeTo(o, c, 1, 3, 8)
                end
            end
        else
            o[#o + 1] = "MainGUI.Frames غير موجود"
        end

        o[#o + 1] = "\n== الريموتس المكتشفة =="
        o[#o + 1] = "TrailShopRequest: " .. (RTrailShop and "✅" or "❌")
        o[#o + 1] = "PickaxeShopRequest: " .. (RPickShop and "✅" or "❌")
        o[#o + 1] = "PetsInventoryRemote: " .. (RPetsInv and "✅" or "❌")
