        o[#o + 1] = "UpgradePlotRequest: " .. (RUpgrade and "✅" or "❌")

        o[#o + 1] = "\n== سجل الأوامر =="
        if #Scout == 0 then o[#o + 1] = "(فارغ، فعّل التسجيل ونفّذ أفعالك يدوياً)" end
        for _, l in ipairs(Scout) do o[#o + 1] = l end
        return table.concat(o, "\n")
    end

