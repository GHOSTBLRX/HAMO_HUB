local function MyPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return end
    for _, p in ipairs(plots:GetChildren()) do
        local pm = p:FindFirstChild("PlotModel")
        if pm and pm:GetAttribute("PlotOwnerUserId") == Player.UserId then
            return p, pm
        end
    end
end

local BaseCFrame, StealCFrame
local function EnsureBase()
    if BaseCFrame then return BaseCFrame end
    local _, pm = MyPlot()
    local r = GetRoot()
    if pm then
        local pos = pm:GetPivot().Position
        if r and (r.Position - pos).Magnitude < 200 then
            BaseCFrame = r.CFrame
        else
            BaseCFrame = CFrame.new(pos + Vector3.new(0, 5, 0))
        end
    elseif r then
        BaseCFrame = r.CFrame
    end
    return BaseCFrame
end

local function GoBase()
    local r = GetRoot()
    if r and EnsureBase() then r.CFrame = BaseCFrame end
end

