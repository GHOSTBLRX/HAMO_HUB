        local highest = 0
        local f = mainFrames()
        local trails = f and f:FindFirstChild("Trails")
        local sf = trails and trails:FindFirstChild("ScrollingFrame")
        if sf then
            for _, c in ipairs(sf:GetChildren()) do
                local n = tonumber(tostring(c.Name):match("Trail(%d+)"))
                if n and n > highest then highest = n end
            end
        end
        if highest == 0 then highest = 20 end

        for id = highest, 1, -1 do
            if not owned[id] then
                local before = Player:GetAttribute("OwnedTrails")
                fireRemote(RTrailShop, "Buy", id)
                task.wait(0.7)
                if Player:GetAttribute("OwnedTrails") ~= before then
                    Stat2Set("✅ اشتريت Trail " .. id)
                    return
                end
            end
        end
        local best = maxKey(parseSet(Player:GetAttribute("OwnedTrails")))
        if best > equipped then
            fireRemote(RTrailShop, "Equip", best)
            Stat2Set("🌈 جهّزت Trail " .. best)
        end
    end
