    local Cool = setmetatable({}, {__mode = "k"})

    local function targets()
        local list, seen, unk = {}, 0, 0
        local pk = workspace:FindFirstChild("AnimalPickups")
        if not pk then return list, 0, 0 end
        local r = GetRoot()
        local now = workspace:GetServerTimeNow()

        for _, m in ipairs(pk:GetChildren()) do
            local hrp = m:FindFirstChild("HumanoidRootPart")
            local pr = hrp and hrp:FindFirstChild("StealPrompt", true)
            if pr and pr.Enabled then
